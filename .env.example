# ==============================================================================
# LiteLLM + Bedrock 环境变量
# ==============================================================================
# 复制为 .env (本地开发) 或 .env.deployed (AWS 部署)：
#   cp .env.example .env
# ==============================================================================

# [可选] LiteLLM Master Key（API 认证 + UI 登录密码）
# 留空不填则 CFN 部署时自动生成 32 位随机字符串并存入 Secrets Manager
# 只有需要自带特定密钥时才填（推荐：sk-$(openssl rand -hex 16)）
LITELLM_MASTER_KEY=

# [可选仅 AWS 部署] PostgreSQL master 密码
# 留空不填则 CFN 部署时自动生成 32 位随机密码存入 Secrets Manager
# 只有需要自带特定密码时才填（1剀6位以上，推荐：Db$(openssl rand -hex 12)）
DB_PASSWORD=

# [可选] Anthropic API Key（Bedrock 限流时的 Fallback）
ANTHROPIC_API_KEY=

# [可选] LiteLLM Enterprise License（解锁 SSO / 审计 / 自定义品牌）
# 留空 = 开源版（已支持模型/Key/Team/Spend UI 管理）
LITELLM_LICENSE_KEY=

# [可选] CloudFront 边缘节点覆盖范围
# PriceClass_100 = 仅北美 + 欧洲（最便宜）
# PriceClass_200 = 加亚太主要区域 + 中东 + 非洲
# PriceClass_All = 全球（默认，含澳大利亚/新西兰/印度尼西亚/南美）
CLOUDFRONT_PRICE_CLASS=

# ===== 仅本地开发需要 (docker-compose) =====
# [仅本地] AWS 凭证（AWS 部署时由 ECS Task Role 自动注入，无需配置）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2
# AWS_SESSION_TOKEN=  # 临时凭证

# ===== 高级（按需启用）=====
# [可选] Langfuse 可观测性（需要在 config.yaml 中启用 success_callback）
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
