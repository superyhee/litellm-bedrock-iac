# ==============================================================================
# LiteLLM + Bedrock environment variables
# ==============================================================================
# Copy to .env (local dev) or .env.deployed (AWS deploy):
#   cp .env.example .env
# ==============================================================================

# [Optional] LiteLLM Master Key (API auth + UI login password)
# Leave empty to let CFN auto-generate a 32-char random string in Secrets Manager.
# Only set this if you need a specific predetermined key (recommended: sk-$(openssl rand -hex 16))
LITELLM_MASTER_KEY=

# [Optional, AWS deploy only] PostgreSQL master password
# Leave empty to let CFN auto-generate a 32-char random password in Secrets Manager.
# Only set this if you need a specific password (16+ chars, recommended: Db$(openssl rand -hex 12))
DB_PASSWORD=

# [Optional] Anthropic API Key (used as fallback when Bedrock throttles)
ANTHROPIC_API_KEY=

# [Optional] LiteLLM Enterprise License (unlocks SSO / Audit / Custom branding)
# Leave empty for the open-source build (already supports model / Key / Team / Spend management via UI)
LITELLM_LICENSE_KEY=

# [Optional] CloudFront edge node coverage
# PriceClass_100 = NA + Europe only (cheapest)
# PriceClass_200 = + Asia Pacific main regions + Middle East + Africa
# PriceClass_All = global (default; includes Australia / NZ / Indonesia / South America)
CLOUDFRONT_PRICE_CLASS=

# ===== Local dev only (docker-compose) =====
# [Local only] AWS credentials (production uses ECS Task Role automatically)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Local dev region — this is the AWS SDK default for the litellm container.
# Bedrock model calls are pinned to us-west-2 in config.yaml regardless,
# so this only affects non-Bedrock SDK calls (rare for local dev).
AWS_DEFAULT_REGION=ap-southeast-1
# AWS_SESSION_TOKEN=  # for temporary credentials

# ===== Advanced (opt-in) =====
# [Optional] Langfuse observability (also enable success_callback in config.yaml)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
